{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/verify",
      "dest": "api/index.py"
    },
    {
      "src": "/download-pdf",
      "dest": "api/index.py"
    },
    {
      "src": "/recyclers",
      "dest": "api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
